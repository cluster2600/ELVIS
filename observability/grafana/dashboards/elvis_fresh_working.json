{
  "id": null,
  "uid": "elvis-fresh-working",
  "title": "ELVIS Fresh Working Dashboard",
  "description": "Brand new ELVIS dashboard with verified working queries",
  "tags": ["elvis", "trading", "fresh", "working"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "liveNow": true,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "ELVIS Trading System Status",
      "type": "text",
      "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0},
      "options": {
        "mode": "html",
        "content": "<div style='text-align: center; font-family: monospace; background: #000; color: #00ff00; padding: 15px; border: 2px solid #00ff00; font-size: 24px; font-weight: bold;'>🚀 ELVIS TRADING SYSTEM - LIVE DATA DASHBOARD 🚀</div>"
      },
      "transparent": true
    },
    {
      "id": 2,
      "title": "💰 BTC Price (BTCUSDT)",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 3},
      "targets": [
        {
          "expr": "elvis_current_price{symbol=\"BTCUSDT\"}",
          "legendFormat": "BTC Price",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {
            "displayMode": "lcd",
            "orientation": "auto"
          },
          "mappings": [],
          "thresholds": {
            "steps": [
              {"color": "green", "value": null}
            ]
          },
          "unit": "currencyUSD",
          "decimals": 2
        }
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "title": "📊 Portfolio Value",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 3},
      "targets": [
        {
          "expr": "elvis_portfolio_value",
          "legendFormat": "Portfolio",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {
            "displayMode": "lcd",
            "orientation": "auto"
          },
          "mappings": [],
          "thresholds": {
            "steps": [
              {"color": "blue", "value": null}
            ]
          },
          "unit": "currencyUSD",
          "decimals": 2
        }
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "title": "🎯 Win Rate",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 3},
      "targets": [
        {
          "expr": "elvis_win_rate",
          "legendFormat": "Win Rate",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {
            "displayMode": "lcd",
            "orientation": "auto"
          },
          "mappings": [],
          "thresholds": {
            "steps": [
              {"color": "green", "value": null}
            ]
          },
          "unit": "percent",
          "decimals": 1
        }
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "title": "📈 Total Trades",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 3},
      "targets": [
        {
          "expr": "elvis_total_trades",
          "legendFormat": "Total Trades",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {
            "displayMode": "lcd",
            "orientation": "auto"
          },
          "mappings": [],
          "thresholds": {
            "steps": [
              {"color": "orange", "value": null}
            ]
          },
          "unit": "short",
          "decimals": 0
        }
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 6,
      "title": "📊 BTC Price Chart (Last 15 minutes)",
      "type": "timeseries",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 9},
      "targets": [
        {
          "expr": "elvis_current_price{symbol=\"BTCUSDT\"}",
          "legendFormat": "BTC Price",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "vis": false},
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "off"}
          },
          "unit": "currencyUSD",
          "decimals": 2
        }
      },
      "options": {
        "legend": {"displayMode": "visible", "placement": "bottom"},
        "tooltip": {"mode": "single", "sort": "none"}
      }
    }
  ],
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": true,
  "style": "dark",
  "hideControls": false
}