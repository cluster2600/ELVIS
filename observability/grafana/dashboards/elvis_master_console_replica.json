  "description": "Master console dashboard - complete ELVIS trading interface with portfolio tracking, market analysis, system monitoring, and live performance metrics",
  "tags": ["elvis", "master", "console", "trading", "portfolio", "live"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 3,
  "refresh": "2s",
  "liveNow": true,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["1s", "2s", "5s", "10s", "30s", "1m", "5m"],
