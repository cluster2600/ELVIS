    {
      "id": 12,
      "title": "🔄 System Activity & Request Monitoring",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [
        {
          "expr": "flask_http_request_total{method=\"GET\",status=\"200\"}",
          "legendFormat": "✅ Successful API Calls",
          "refId": "A"
        },
        {
          "expr": "rate(flask_http_request_total{method=\"GET\",status=\"200\"}[1m]) * 60",
          "legendFormat": "🔄 Request Rate (/min)",
          "refId": "B"
        },
        {
          "expr": "flask_http_request_duration_seconds_sum",
