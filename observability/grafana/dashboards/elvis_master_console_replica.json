          {"text": "BNBBTC", "value": "BNBBTC", "selected": false}
        ],
        "current": {"text": "BTCUSDT", "value": "BTCUSDT"},
        "multi": false,
        "includeAll": false,
        "refresh": 1
      }
    ]
