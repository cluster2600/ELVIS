    {
      "id": 10,
      "title": "🎯 Live Performance Dashboard",
      "type": "stat",
      "gridPos": {"h": 8, "w": 10, "x": 14, "y": 16},
      "targets": [
        {
          "expr": "up{job=\"elvis\"}",  
          "legendFormat": "🔌 System Status",
          "refId": "A"
        },
        {
          "expr": "flask_http_request_duration_seconds_sum / flask_http_request_duration_seconds_count",
