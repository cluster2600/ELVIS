      },
      "transparent": true
    },
    {
      "id": 2,
      "title": "💰 Live Market Price",
      "type": "stat",
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 3},
      "targets": [
        {
          "expr": "elvis_current_price{symbol=\"$symbol\"}",
          "legendFormat": "${symbol}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {
            "displayMode": "lcd",
            "orientation": "auto",
            "showUnfilled": true
          },
          "mappings": [],
          "thresholds": {
            "steps": [
              {"color": "rgba(50, 172, 45, 0.97)", "value": null}
            ]
          },
          "unit": "currencyUSD",
          "decimals": 2
        }
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "title": "📊 RSI Oscillator",
      "type": "gauge",
      "gridPos": {"h": 5, "w": 4, "x": 4, "y": 3},
      "targets": [
        {
          "expr": "elvis_rsi{symbol=\"$symbol\"}",
          "legendFormat": "RSI",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"options": {"from": 0, "to": 30}, "type": "range", "result": {"text": "🔴 OVERSOLD", "color": "red"}},
            {"options": {"from": 30, "to": 40}, "type": "range", "result": {"text": "🟠 BEARISH", "color": "orange"}},
            {"options": {"from": 40, "to": 60}, "type": "range", "result": {"text": "🟡 NEUTRAL", "color": "yellow"}},
            {"options": {"from": 60, "to": 70}, "type": "range", "result": {"text": "🟢 BULLISH", "color": "light-green"}},
            {"options": {"from": 70, "to": 100}, "type": "range", "result": {"text": "🔴 OVERBOUGHT", "color": "red"}}
          ],
          "thresholds": {
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 30},
              {"color": "yellow", "value": 40},
              {"color": "light-green", "value": 60},
              {"color": "red", "value": 70}
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "showThresholdLabels": true,
        "showThresholdMarkers": true,
        "text": {"titleSize": 10, "valueSize": 14}
      }
    },
    {
      "id": 4,
      "title": "📈 MACD Convergence",
      "type": "timeseries",
      "gridPos": {"h": 5, "w": 4, "x": 8, "y": 3},
      "targets": [
        {
          "expr": "elvis_macd{symbol=\"$symbol\"}",
          "legendFormat": "MACD",
          "refId": "A"
        },
        {
          "expr": "elvis_macd_signal{symbol=\"$symbol\"}",
          "legendFormat": "Signal",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "hue",
            "hideFrom": {"legend": false, "tooltip": false, "vis": false},
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "line", "steps": [{"color": "red", "value": 0}]}
