# Simple Dockerfile for ELVIS Trading Bot - Network Resilient Version
FROM python:3.14-slim

# Set environment variables for better package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Use multiple mirror attempts and install essential packages
RUN apt-get update --fix-missing || true && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* || true

# Set working directory
WORKDIR /app

# Copy application code
COPY . /app

# Install Python packages from project metadata
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir --timeout 30 --retries 3 --prefer-binary ta-lib && \
    pip install --no-cache-dir --timeout 30 --retries 3 --prefer-binary -r requirements.txt

# Create necessary directories and set permissions
RUN mkdir -p /app/logs /app/models /app/data /app/tmp && \
    chmod -R 755 /app

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash elvis && \
    chown -R elvis:elvis /app

# Switch to non-root user
USER elvis

# Expose ports for dashboard and metrics
EXPOSE 5050 8000

# Add health check that works with Apple Container
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import sys; import os; sys.path.insert(0, '/app'); print('ELVIS Health Check: OK')" || exit 1

# Start ELVIS with proper configuration
CMD ["python", "main.py", "--mode", "paper", "--log-level", "INFO"]
