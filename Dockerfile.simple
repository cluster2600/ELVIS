# Simple Dockerfile for ELVIS Trading Bot - Network Resilient Version
FROM python:3.11-slim

# Set environment variables for better package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Use multiple mirror attempts and install essential packages
RUN apt-get update --fix-missing || true && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* || true

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt /app/requirements.txt

# Install Python packages with retry and fallback
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir --timeout 30 --retries 3 \
    numpy pandas scipy scikit-learn matplotlib tqdm pyyaml requests \
    Flask Flask-CORS prometheus-flask-exporter \
    redis prometheus-client SQLAlchemy websocket-client psycopg2-binary \
    psutil python-dotenv keyring ccxt python-binance python-telegram-bot \
    colorlog ta hvac statsmodels coremltools torch

# Copy application code
COPY . /app

# Create necessary directories and set permissions
RUN mkdir -p /app/logs /app/models /app/data /app/tmp && \
    chmod -R 755 /app

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash elvis && \
    chown -R elvis:elvis /app

# Switch to non-root user
USER elvis

# Expose ports for dashboard and metrics
EXPOSE 5050 8000

# Add health check that works with Apple Container
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import sys; import os; sys.path.insert(0, '/app'); print('ELVIS Health Check: OK')" || exit 1

# Start ELVIS with proper configuration
CMD ["python", "main.py", "--mode", "paper", "--log-level", "INFO"]