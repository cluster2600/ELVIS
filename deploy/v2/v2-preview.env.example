# ELVIS V2 operator preview v2.0.0-alpha.2
# This exact prerelease tag never resolves through a floating "latest" alias.
ELVIS_V2_OPERATOR_IMAGE=ghcr.io/cluster2600/elvis-v2-operator:2.0.0-alpha.2
ELVIS_V2_OPERATOR_DIR=./operator

# Optional. The hardened image defaults to its unprivileged 65532:65532 user.
# Export these variables to your host UID/GID when mounted operator files are
# private to your account:
# ELVIS_V2_OPERATOR_UID=1000
# ELVIS_V2_OPERATOR_GID=1000
