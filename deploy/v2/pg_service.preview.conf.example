# Copy to operator/pg_service.conf and replace every *.example.invalid host.
# Keep credentials out of this file; put them in the mode-0600 pgpass file.
# Every service fails closed unless the server certificate chains to the
# operator-controlled CA and its DNS name matches the configured host.

[elvis_v2_admin]
host=fresh-target.example.invalid
port=5432
dbname=elvis_paper_v2_rehearsal
user=elvis_bootstrap_admin
sslmode=verify-full
sslrootcert=/run/operator/ca.crt

[elvis_v2_migrator]
host=fresh-target.example.invalid
port=5432
dbname=elvis_paper_v2_rehearsal
user=elvis_v2_migrator
sslmode=verify-full
sslrootcert=/run/operator/ca.crt

[elvis_v2_readiness]
host=fresh-target.example.invalid
port=5432
dbname=elvis_paper_v2_rehearsal
user=elvis_v2_readiness
sslmode=verify-full
sslrootcert=/run/operator/ca.crt

[elvis_v2_trainer]
host=fresh-target.example.invalid
port=5432
dbname=elvis_paper_v2_rehearsal
user=elvis_v2_trainer
sslmode=verify-full
sslrootcert=/run/operator/ca.crt

[elvis_source_clone]
host=stopped-source-clone.example.invalid
port=5432
dbname=elvis_trading
user=elvis_user
sslmode=verify-full
sslrootcert=/run/operator/ca.crt

[elvis_fresh_target_admin]
host=fresh-target.example.invalid
port=5432
dbname=elvis_paper_v2
user=elvis_bootstrap_admin
sslmode=verify-full
sslrootcert=/run/operator/ca.crt

[elvis_fresh_target_migrator]
host=fresh-target.example.invalid
port=5432
dbname=elvis_paper_v2
user=elvis_migrator
sslmode=verify-full
sslrootcert=/run/operator/ca.crt

[elvis_fresh_target_readiness]
host=fresh-target.example.invalid
port=5432
dbname=elvis_paper_v2
user=elvis_readiness
sslmode=verify-full
sslrootcert=/run/operator/ca.crt
