# HashiCorp Vault Configuration
VAULT_ENABLED=true
VAULT_URL=http://localhost:8200
VAULT_TOKEN=trading-bot-token
VAULT_CACHE_KEY=your_cache_encryption_key_here

# Redis Configuration (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Trading Configuration
TRADING_MODE=paper  # paper or live
STRATEGY_MODE=balanced  # Use balanced strategy with optimized settings
MAX_POSITION_SIZE=0.2  # Increased for profitable position sizes
MAX_DAILY_TRADES=200  # Increased for active profitable trading
RISK_PER_TRADE=0.02

# Monitoring
PROMETHEUS_PUSHGATEWAY_URL=http://localhost:9091

# NOTE: All sensitive secrets (API keys, passwords, tokens) should now be stored in Vault
# Use the following commands to migrate and manage secrets:
#
# 1. Setup Vault and migrate secrets:
#    python scripts/setup_vault.py --all
#
# 2. Manage secrets:
#    python scripts/vault_admin.py --list
#    python scripts/vault_admin.py --add
#    python scripts/vault_admin.py --test
#
# 3. Check Vault status:
#    python scripts/vault_admin.py --status