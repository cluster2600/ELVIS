{
  "id": null,
  "uid": "elvis-simple-test",
  "title": "ELVIS Simple Test Dashboard",
  "description": "Simple test dashboard with basic ELVIS metrics",
  "tags": ["elvis", "test"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "liveNow": true,
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "🚀 ELVIS System Status",
      "type": "text",
      "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0},
      "options": {
        "mode": "html",
        "content": "<div style='text-align: center; font-size: 24px; font-weight: bold; color: #00ff00; font-family: monospace; background: #000; padding: 10px; border: 2px solid #00ff41; border-radius: 8px;'>🚀 ELVIS TRADING SYSTEM - ALL SYSTEMS OPERATIONAL ✅</div>"
      },
      "transparent": true
    },
    {
      "id": 2,
      "title": "💰 Portfolio Value",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 3},
      "targets": [
        {
          "expr": "elvis_portfolio_value",
          "legendFormat": "Portfolio Value",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"displayMode": "lcd", "orientation": "auto"},
          "unit": "currencyUSD",
          "decimals": 2
        }
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "title": "📊 Total Trades",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 3},
      "targets": [
        {
          "expr": "elvis_total_trades",
          "legendFormat": "Total Trades",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"displayMode": "lcd", "orientation": "auto"},
          "unit": "short",
          "decimals": 0
        }
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "title": "🎯 Win Rate",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 3},
      "targets": [
        {
          "expr": "elvis_win_rate",
          "legendFormat": "Win Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"displayMode": "lcd", "orientation": "auto"},
          "unit": "percent",
          "decimals": 1
        }
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "title": "📈 BTC Price",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 3},
      "targets": [
        {
          "expr": "elvis_current_price{symbol=\"BTCUSDT\"}",
          "legendFormat": "BTC Price",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"displayMode": "lcd", "orientation": "auto"},
          "unit": "currencyUSD",
          "decimals": 2
        }
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      }
    }
  ],
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": true,
  "style": "dark",
  "hideControls": false
}