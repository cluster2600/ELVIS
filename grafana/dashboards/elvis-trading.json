{
  "id": null,
  "uid": "elvis-trading",
  "title": "ELVIS Minimal Trading Dashboard",
  "tags": ["elvis", "trading"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 4,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "BTC/USDT Price",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "elvis_current_price", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "usd" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Portfolio Value",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "elvis_portfolio_value", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "usd" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 8 }
    },
    {
      "type": "stat",
      "title": "EMA Long",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "elvis_ema_long", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "usd" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 8 }
    },
    {
      "type": "stat",
      "title": "RSI",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "elvis_rsi", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 12 }
    },
    {
      "type": "stat",
      "title": "MACD",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "elvis_macd", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 12 }
    },
    {
      "type": "stat",
      "title": "Trades Executed",
      "datasource": "elvis-json-datasource",
      "targets": [
        {
          "method": "GET",
          "urlPath": "/trades/count",
          "refId": "A",
          "cacheDurationSeconds": 30,
          "fields": [
            { "jsonPath": "$[*].fee" }
          ],
          "reduce": {
            "function": "sum"
          }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 16 }
    },
    {
      "type": "table",
      "title": "Open Positions",
      "datasource": "elvis-json-datasource",
      "targets": [
        {
          "method": "GET",
          "urlPath": "/open_positions",
          "refId": "A",
          "cacheDurationSeconds": 30,
          "fields": [
            { "jsonPath": "$[*].symbol", "name": "symbol" },
            { "jsonPath": "$[*].entry_price", "name": "entry_price" },
            { "jsonPath": "$[*].quantity", "name": "quantity" },
            { "jsonPath": "$[*].leverage", "name": "leverage" },
            { "jsonPath": "$[*].entry_time", "name": "entry_time" }
          ]
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "center" } },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 20 }
    },
    {
      "type": "table",
      "title": "Transaction History",
      "datasource": "elvis-json-datasource",
      "targets": [
        {
          "method": "GET",
          "urlPath": "/trades",
          "refId": "A",
          "cacheDurationSeconds": 30,
          "fields": [
            { "jsonPath": "$[*].timestamp", "name": "timestamp" },
            { "jsonPath": "$[*].symbol", "name": "symbol" },
            { "jsonPath": "$[*].side", "name": "side" },
            { "jsonPath": "$[*].price", "name": "price" },
            { "jsonPath": "$[*].quantity", "name": "quantity" },
            { "jsonPath": "$[*].pnl", "name": "pnl" }
          ]
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "center" } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 26 }
    },
    {
      "type": "timeseries",
      "title": "Real-time PnL Last 24 Hours",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "elvis_unrealized_pnl",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currency(USD)"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 34 }
    },
    {
      "type": "stat",
      "title": "Binance Fees",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "elvis_funding_rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 42 }
    },
    {
      "type": "stat",
      "title": "Sum of Binance Fees",
      "datasource": "elvis-json-datasource",
      "targets": [
        {
          "method": "GET",
          "urlPath": "/trades",
          "refId": "A",
          "cacheDurationSeconds": 30,
          "fields": [
            { "jsonPath": "$[*].pnl", "type": "number" }
          ],
          "reduce": {
            "function": "sum"
          },
          "alias": "Total PNL (as Fees Proxy)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currency(USD)"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 42 }
    }
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  }
}
