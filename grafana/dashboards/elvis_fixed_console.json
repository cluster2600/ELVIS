        {
          "expr": "elvis_system_memory_percent",
          "legendFormat": "💾 Memory Usage %",
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        },
        {
          "expr": "rate(flask_http_request_total{job=\"elvis\"}[1m]) * 60",
          "legendFormat": "🔄 Requests/min",
          "refId": "C",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 80}
            ]
          },
          "unit": "percent",
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "🔄 Requests/min"},
            "properties": [
              {"id": "unit", "value": "reqps"},
              {"id": "decimals", "value": 2}
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "vertical",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
