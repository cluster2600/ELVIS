{
  "id": null,
  "uid": "elvis-fixed-console",
  "title": "ELVIS Trading Console - Fixed Data",
  "description": "Fixed ELVIS console dashboard with working metrics and log integration",
  "tags": ["elvis", "trading", "console", "fixed"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "2s",
  "liveNow": true,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["1s", "2s", "5s", "10s", "30s", "1m"],
    "time_options": ["5m", "15m", "30m", "1h", "3h", "6h", "12h", "24h"]
  },
  "templating": {
    "list": [
      {
        "name": "symbol",
        "type": "custom",
        "label": "Trading Symbol",
        "options": [
          {"text": "BTCUSDT", "value": "BTCUSDT", "selected": true},
          {"text": "BNBBTC", "value": "BNBBTC", "selected": false}
        ],
        "current": {"text": "BTCUSDT", "value": "BTCUSDT"},
        "multi": false,
        "includeAll": false,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "",
