            "minWidth": 100
          },
          "mappings": [],
          "thresholds": {
            "steps": [
              {"color": "green", "value": null}
            ]
          },
          "color": {"mode": "thresholds"},
          "decimals": 2
        }
      },
      "options": {
        "showHeader": true,
        "cellHeight": "lg",
        "footer": {"show": false, "reducer": ["sum"], "countRows": false, "fields": ""}
      },
      "transformations": [
        {
          "id": "seriesToColumns",
          "options": {"byField": "__name__"}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "__name__": true, "instance": true, "job": true},
            "indexByName": {},
            "renameByName": {}
          }
        }
      ]
