            "properties": [
              {"id": "unit", "value": "reqps"},
              {"id": "mappings", "value": []},
              {"id": "decimals", "value": 2},
              {"id": "color", "value": {"mode": "palette-classic"}}
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "vertical",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
