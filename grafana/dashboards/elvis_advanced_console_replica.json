      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
      "options": {
        "mode": "html",
        "content": "<div style='text-align: center; font-family: monospace; background: linear-gradient(135deg, #000 0%, #1a1a2e 50%, #16213e 100%); padding: 15px; border-radius: 8px; border: 2px solid #00ff41;'><div style='font-size: 32px; font-weight: bold; color: #00ff41; text-shadow: 0 0 10px #00ff41; margin-bottom: 8px;'>███████╗██╗     ██╗   ██╗██╗███████╗</div><div style='font-size: 32px; font-weight: bold; color: #00ff41; text-shadow: 0 0 10px #00ff41; margin-bottom: 8px;'>██╔════╝██║     ██║   ██║██║██╔════╝</div><div style='font-size: 32px; font-weight: bold; color: #00ff41; text-shadow: 0 0 10px #00ff41; margin-bottom: 8px;'>█████╗  ██║     ██║   ██║██║███████╗</div><div style='font-size: 32px; font-weight: bold; color: #00ff41; text-shadow: 0 0 10px #00ff41; margin-bottom: 8px;'>██╔══╝  ██║     ██║   ██║██║╚════██║</div><div style='font-size: 32px; font-weight: bold; color: #00ff41; text-shadow: 0 0 10px #00ff41; margin-bottom: 8px;'>███████╗███████╗╚██████╔╝██║███████║</div><div style='font-size: 32px; font-weight: bold; color: #00ff41; text-shadow: 0 0 10px #00ff41; margin-bottom: 15px;'>╚══════╝╚══════╝ ╚═════╝ ╚═╝╚══════╝</div><div style='font-size: 18px; font-weight: bold; color: #ffff00; text-shadow: 0 0 8px #ffff00; animation: blink 2s infinite;'>🔴 LIVE TRADING ACTIVE 🔴</div><div style='font-size: 14px; color: #00ffff; margin-top: 8px;'>Enhanced Leveraged Virtual Investment System</div></div><style>@keyframes blink { 0%, 50% { opacity: 1; } 51%, 100% { opacity: 0.3; } }</style>"
      },
      "transparent": true
    },
    {
      "id": 2,
      "title": "💰 Live Price & Change",
      "type": "stat",
      "gridPos": {"h": 6, "w": 4, "x": 0, "y": 4},
      "targets": [
        {
          "expr": "elvis_current_price{symbol=\"$symbol\"}",
          "legendFormat": "${symbol}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {
            "displayMode": "lcd",
            "orientation": "auto",
            "showUnfilled": true
          },
          "mappings": [],
          "thresholds": {
            "steps": [
              {"color": "green", "value": null}
            ]
          },
          "unit": "currencyUSD",
          "decimals": 2
        }
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "title": "📊 RSI Momentum",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 4, "x": 4, "y": 4},
      "targets": [
        {
          "expr": "elvis_rsi{symbol=\"$symbol\"}",
          "legendFormat": "RSI",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"options": {"from": 0, "to": 30}, "type": "range", "result": {"text": "OVERSOLD", "color": "red"}},
            {"options": {"from": 30, "to": 40}, "type": "range", "result": {"text": "BEARISH", "color": "orange"}},
            {"options": {"from": 40, "to": 60}, "type": "range", "result": {"text": "NEUTRAL", "color": "yellow"}},
            {"options": {"from": 60, "to": 70}, "type": "range", "result": {"text": "BULLISH", "color": "light-green"}},
            {"options": {"from": 70, "to": 100}, "type": "range", "result": {"text": "OVERBOUGHT", "color": "red"}}
          ],
          "thresholds": {
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 30},
              {"color": "yellow", "value": 40},
              {"color": "light-green", "value": 60},
              {"color": "red", "value": 70}
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "showThresholdLabels": true,
        "showThresholdMarkers": true,
        "text": {"titleSize": 12, "valueSize": 16}
      }
    },
    {
      "id": 4,
      "title": "📈 MACD Signals",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 4, "x": 8, "y": 4},
      "targets": [
        {
          "expr": "elvis_macd{symbol=\"$symbol\"}",
          "legendFormat": "MACD",
          "refId": "A"
        },
        {
          "expr": "elvis_macd_signal{symbol=\"$symbol\"}",
          "legendFormat": "Signal",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "hue",
            "hideFrom": {"legend": false, "tooltip": false, "vis": false},
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "line", "steps": [{"color": "red", "value": 0}]}
          },
          "unit": "short",
          "decimals": 4
        }
      },
      "options": {
        "legend": {"displayMode": "visible", "placement": "bottom", "values": ["last"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 5,
      "title": "⚡ System Health",
      "type": "stat",
      "gridPos": {"h": 6, "w": 4, "x": 12, "y": 4},
      "targets": [
        {
          "expr": "up{job=\"elvis\"}",
          "legendFormat": "API",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"options": {"0": {"text": "❌ OFFLINE", "color": "red"}}, "type": "value"},
            {"options": {"1": {"text": "✅ ONLINE", "color": "green"}}, "type": "value"}
          ],
          "thresholds": {
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          },
          "unit": "none"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value",
        "text": {"titleSize": 12, "valueSize": 18}
      }
    },
    {
