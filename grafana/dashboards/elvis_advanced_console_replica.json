{
  "id": null,
  "uid": "elvis-console-advanced",
  "title": "ELVIS Advanced Console Dashboard Replica",
  "description": "Advanced replica of ELVIS console dashboard with enhanced features: portfolio tracking, position analysis, market depth simulation, risk metrics, and live trading logs",
  "tags": ["elvis", "trading", "console", "advanced", "replica"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "1s",
  "liveNow": true,
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["1s", "2s", "5s", "10s", "30s", "1m"],
    "time_options": ["5m", "15m", "30m", "1h", "3h", "6h", "12h", "24h"]
  },
  "variables": [
    {
      "name": "symbol",
      "type": "custom",
      "label": "Trading Pair",
      "options": [
        {"text": "BTCUSDT", "value": "BTCUSDT", "selected": true},
        {"text": "BNBBTC", "value": "BNBBTC", "selected": false}
      ],
      "current": {"text": "BTCUSDT", "value": "BTCUSDT"},
      "multi": false,
      "includeAll": false
    },
    {
      "name": "timeframe",
      "type": "custom",
      "label": "Chart Timeframe",
      "options": [
        {"text": "1m", "value": "1m", "selected": false},
        {"text": "5m", "value": "5m", "selected": true},
        {"text": "15m", "value": "15m", "selected": false},
        {"text": "1h", "value": "1h", "selected": false}
      ],
      "current": {"text": "5m", "value": "5m"},
      "multi": false,
      "includeAll": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "",
