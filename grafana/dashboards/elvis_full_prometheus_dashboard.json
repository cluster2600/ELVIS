{
    "id": null,
    "uid": "elvis-prometheus-dashboard",
    "title": "ELVIS Full Prometheus Dashboard",
    "timezone": "browser",
    "schemaVersion": 41,
    "version": 1,
    "refresh": "30s",
    "panels": [
        {
            "type": "timeseries",
            "title": "BTC Price & Moving Averages",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "elvis_current_price",
                    "refId": "A"
                },
                {
                    "expr": "elvis_sma",
                    "refId": "B"
                },
                {
                    "expr": "elvis_ema_short",
                    "refId": "C"
                },
                {
                    "expr": "elvis_ema_long",
                    "refId": "D"
                }
            ],
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 0
            }
        },
        {
            "type": "timeseries",
            "title": "RSI & MACD",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "elvis_rsi",
                    "refId": "A"
                },
                {
                    "expr": "elvis_macd",
                    "refId": "B"
                },
                {
                    "expr": "elvis_macd_signal",
                    "refId": "C"
                }
            ],
            "gridPos": {
                "h": 6,
                "w": 24,
                "x": 0,
                "y": 8
            }
        },
        {
            "type": "stat",
            "title": "Portfolio Value",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "elvis_portfolio_value",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "currency(USD)"
                }
            },
            "gridPos": {
                "h": 4,
                "w": 12,
                "x": 0,
                "y": 14
            }
        },
        {
            "type": "stat",
            "title": "Unrealized PnL",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "elvis_unrealized_pnl",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "currency(USD)"
                }
            },
            "gridPos": {
                "h": 4,
                "w": 12,
                "x": 12,
                "y": 14
            }
        },
        {
